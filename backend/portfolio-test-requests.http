#Retrieve all test
GET http://localhost:3000/exercises HTTP/1.1

###
#Retrieve exercise by name tests
GET http://localhost:3000/exercises?name=The Kathy HTTP/1.1

###
GET http://localhost:3000/exercises?name=The Big One HTTP/1.1

###
#Retrieve exercise by other criteria
GET http://localhost:3000/exercises?date=05-24-2026 HTTP/1.1

###
GET http://localhost:3000/exercises?reps=5 HTTP/1.1

###
GET http://localhost:3000/exercises?unit=lbs HTTP/1.1

###
#Retrieve by multiple criteria
GET http://localhost:3000/exercises?name=Cronch&reps=5&unit=lbs HTTP/1.1

###
#Retrieve by id
GET http://localhost:3000/exercises/{{TEST_ID}} HTTP/1.1

###
#Test invalid id
GET http://localhost:3000/exercises/{{INVALID_USER_ID}} HTTP/1.1

###
#Test update
PUT http://localhost:3000/exercises/{{TEST_ID}} HTTP/1.1
content-type: application/json

{
    "reps": 15,
    "unit": "kgs"
}

###
PUT http://localhost:3000/exercises/{{TEST_ID}} HTTP/1.1
content-type: application/json

