#ADDITIONAL TESTING
### Valid 1 - basic
POST http://localhost:3000/exercises HTTP/1.1
content-type: application/json

{
    "name": "Crunch",
    "reps": 5,
    "weight": 20,
    "unit": "lbs",
    "date": "05-24-26"
}

### Valid 2 - kgs unit
POST http://localhost:3000/exercises HTTP/1.1
content-type: application/json

{
    "name": "Squat",
    "reps": 10,
    "weight": 60,
    "unit": "kgs",
    "date": "01-15-26"
}

### Valid 3 - single-char name
POST http://localhost:3000/exercises HTTP/1.1
content-type: application/json

{
    "name": "A",
    "reps": 1,
    "weight": 1,
    "unit": "lbs",
    "date": "12-31-25"
}

### Valid 4 - larger numbers
POST http://localhost:3000/exercises HTTP/1.1
content-type: application/json

{
    "name": "Deadlift",
    "reps": 100,
    "weight": 315,
    "unit": "lbs",
    "date": "07-04-26"
}

### Valid 5 - multi-word name
POST http://localhost:3000/exercises HTTP/1.1
content-type: application/json

{
    "name": "Bench Press",
    "reps": 8,
    "weight": 135,
    "unit": "lbs",
    "date": "03-01-26"
}

### Valid 6 - kgs, low reps/weight
POST http://localhost:3000/exercises HTTP/1.1
content-type: application/json

{
    "name": "Lunge",
    "reps": 12,
    "weight": 5,
    "unit": "kgs",
    "date": "09-09-26"
}

### Valid 7 - date at year boundary
POST http://localhost:3000/exercises HTTP/1.1
content-type: application/json

{
    "name": "Pull-up",
    "reps": 6,
    "weight": 1,
    "unit": "lbs",
    "date": "12-31-99"
}

### Valid 8 - date at start of year
POST http://localhost:3000/exercises HTTP/1.1
content-type: application/json

{
    "name": "Plank Hold",
    "reps": 1,
    "weight": 1,
    "unit": "kgs",
    "date": "01-01-00"
}

### Valid 9 - special characters in name
POST http://localhost:3000/exercises HTTP/1.1
content-type: application/json

{
    "name": "Sit-Up's (weighted)",
    "reps": 15,
    "weight": 10,
    "unit": "lbs",
    "date": "06-15-26"
}

### Valid 10 - large weight value
POST http://localhost:3000/exercises HTTP/1.1
content-type: application/json

{
    "name": "Leg Press",
    "reps": 20,
    "weight": 999,
    "unit": "kgs",
    "date": "11-11-26"
}

